# NextArcher FastAPI Python Backend Environment Configuration (.env)

# 1. Supabase PostgreSQL Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 2. JWT Security & Password Encryption Configuration
JWT_SECRET_KEY=nextarcher_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Fast2SMS OTP Gateway (Optional for SMS OTP)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
